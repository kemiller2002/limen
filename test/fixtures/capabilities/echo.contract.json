  "types": [
    {
      "name": "EchoRequest",
      "kind": "union",
      "tag": "operation",
      "variants": [
        { "name": "echo", "fields": [ { "name": "text", "type": "string" } ] },
        { "name": "wait", "fields": [ { "name": "ms", "type": "int" } ] },
        { "name": "announce", "fields": [ { "name": "text", "type": "string" } ] }
      ]
    },
    {
      "name": "EchoResult",
      "kind": "union",
      "tag": "kind",
      "variants": [
        { "name": "Echoed", "fields": [ { "name": "text", "type": "string" } ] },
        { "name": "Waited", "fields": [] },
        { "name": "Cancelled", "fields": [] },
        { "name": "Announced", "fields": [] }
      ]
    },
    {
      "name": "EchoFact",
      "kind": "record",
      "fields": [ { "name": "text", "type": "string" } ]
    }
  ]
}
