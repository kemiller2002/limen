{
  "unit": "limen.core",
  "doc": "Shared semantic vectors. Every language binding must accept every valid vector and round-trip it to equal JSON, and reject every invalid vector at exactly errorPath. Keys are ASCII so path rendering is identical in every language.",
  "vectors": [
    {
      "name": "initialize without handshake (a 1.0 kernel)",
      "type": "BrowserToEngineMessage",
      "valid": true,
      "json": {
        "kind": "Initialize",
        "protocolVersion": 1,
        "capabilities": [
          "Http",
          "Storage",
          "Clipboard",
          "Navigation"
        ],
        "location": {
          "origin": "https://example.com",
          "path": "/invoices/42",
          "query": "?tab=history",
          "hash": ""
        }
      }
    },
    {
      "name": "initialize with handshake",
      "type": "BrowserToEngineMessage",
      "valid": true,
      "json": {
        "kind": "Initialize",
        "protocolVersion": 1,
        "capabilities": [
          "Http"
        ],
        "location": {
          "origin": "https://example.com",
          "path": "/invoices/42",
          "query": "?tab=history",
          "hash": ""
        },
        "handshake": {
          "protocol": {
            "major": 1,
            "minor": 1
          },
          "contract": {
            "unit": "limen.core",
            "version": 1,
            "fingerprint": "sha256:abc"
          },
          "capabilities": [
            {
              "id": "limen.focus",
              "version": 1,
              "fingerprint": "sha256:def"
            }
          ]
        }
      }
    },
    {
