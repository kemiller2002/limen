    {
      "name": "repeated keyed fields preserve identity",
      "schema": "order",
      "steps": [
        {
          "load": {
            "values": {
              "customer": "ACME"
            },
            "rows": {
              "lines": [
                {
                  "key": "a",
                  "values": {
                    "item": "Pen",
                    "qty": "2"
                  }
                },
                {
                  "key": "b",
                  "values": {
                    "item": "Ink",
                    "qty": "1"
                  }
                }
              ]
            }
          },
          "expect": {
            "rows": {
              "lines": [
                "a",
                "b"
              ]
            },
            "dirty": false
          }
        },
        {
          "input": {
            "field": "lines[b].qty",
            "value": "0"
          },
          "expect": {
            "fields": {
              "lines[b].qty": {
                "value": "0",
                "errors": [
                  "below-min"
                ],
                "dirty": true
              }
            }
          }
        },
        {
          "blur": {
            "field": "lines[b].qty"
          },
          "expect": {
            "fields": {
              "lines[b].qty": {
                "touched": true
              }
            }
          }
        },
        {
          "addRow": {
            "group": "lines",
            "key": "c"
          },
          "expect": {
            "rows": {
              "lines": [
                "a",
                "b",
                "c"
              ]
            },
            "dirty": true,
            "fields": {
              "lines[c].item": {
                "value": "",
                "errors": [
                  "required"
                ],
                "touched": false
              }
            }
          }
        },
        {
          "addRow": {
            "group": "lines",
            "key": "b"
          },
          "expect": {
            "ignored": "duplicate-row",
            "rows": {
              "lines": [
                "a",
                "b",
                "c"
              ]
            }
          }
        },
        {
          "removeRow": {
            "group": "lines",
            "key": "a"
          },
          "expect": {
            "rows": {
              "lines": [
                "b",
                "c"
              ]
            },
            "fields": {
              "lines[b].qty": {
                "value": "0",
                "touched": true,
                "errors": [
                  "below-min"
                ]
              }
            }
          }
        },
        {
          "removeRow": {
            "group": "lines",
            "key": "a"
          },
          "expect": {
            "ignored": "unknown-row"
          }
        },
        {
          "input": {
            "field": "lines[a].qty",
            "value": "5"
          },
          "expect": {
            "ignored": "unknown-field"
          }
        },
        {
          "addRow": {
            "group": "lines",
            "key": "a"
          },
          "expect": {
            "rows": {
              "lines": [
                "b",
                "c",
                "a"
              ]
            },
            "fields": {
              "lines[a].item": {
                "value": "",
                "dirty": false,
                "touched": false
              }
            }
          }
        },
        {
          "submit": {
            "submitter": "save"
          },
          "expect": {
            "ignored": "invalid",
            "fields": {
              "lines[a].item": {
                "touched": true
              },
              "lines[c].qty": {
                "touched": true
              },
              "customer": {
                "touched": true
              }
            }
          }
        }
      ]
    },
    {
      "name": "reset restores the original model",
      "schema": "order",
      "steps": [
        {
          "load": {
            "values": {
              "customer": "ACME"
            },
            "rows": {
              "lines": [
                {
                  "key": "a",
                  "values": {
                    "item": "Pen",
                    "qty": "2"
                  }
                }
              ]
            }
          },
          "expect": {
            "dirty": false
          }
        },
        {
          "input": {
            "field": "customer",
            "value": ""
          },
          "expect": {
            "fields": {
              "customer": {
                "errors": [
                  "required"
                ]
              }
            }
          }
        },
        {
          "blur": {
            "field": "customer"
          },
          "expect": {
            "fields": {
              "customer": {
                "touched": true
              }
            }
          }
        },
        {
