{
  "doc": "Language-neutral form-state semantics (kemiller2002/limen#21, LCP-006). conformance/forms/README.md states the rules; these scenarios are the rules as data. Each step applies one command to the form and states the part of the resulting snapshot it cares about, plus exactly what the command emitted and why it was ignored, if it was. The F# reference library runs them in conformance/forms/fsharp/.",
  "schemas": {
    "signup": {
      "fields": [
        {
          "name": "email",
          "kind": "text",
          "required": true,
          "maxLength": 40,
          "asyncValidator": "emailAvailable"
        },
        {
          "name": "password",
          "kind": "text",
          "required": true,
          "minLength": 8
        },
        {
          "name": "age",
          "kind": "integer",
          "min": 13,
          "max": 130
        },
        {
          "name": "plan",
          "kind": "choice",
          "options": [
            "free",
            "pro"
          ],
          "required": true
        },
        {
          "name": "company",
          "kind": "text",
          "requiredWhen": {
            "field": "plan",
            "equals": "pro"
          },
          "visibleWhen": {
            "field": "plan",
            "equals": "pro"
          }
        },
        {
          "name": "topics",
          "kind": "choices",
          "options": [
            "news",
            "tips",
            "offers"
          ],
          "maxCount": 2
        },
        {
          "name": "terms",
          "kind": "flag",
          "required": true
        },
        {
          "name": "start",
          "kind": "date",
          "min": "2026-01-01"
        },
        {
          "name": "at",
          "kind": "time"
        },
        {
          "name": "budget",
          "kind": "number",
          "min": 0
        },
        {
          "name": "referral",
          "kind": "text",
          "readonly": true
        },
        {
          "name": "legacyId",
          "kind": "text",
          "disabled": true
        }
      ],
      "groups": []
    },
    "order": {
      "fields": [
        {
          "name": "customer",
          "kind": "text",
          "required": true
        }
      ],
      "groups": [
        {
          "name": "lines",
          "fields": [
            {
              "name": "item",
              "kind": "text",
              "required": true
            },
            {
              "name": "qty",
              "kind": "integer",
              "required": true,
              "min": 1
            }
          ]
        }
      ]
    }
  },
  "scenarios": [
    {
      "name": "invalid submit marks the intended fields touched, and only those",
      "schema": "signup",
      "steps": [
        {
          "load": {
            "values": {
              "referral": "friend-7",
              "legacyId": "L-1",
              "terms": "false"
            },
            "rows": {}
          },
          "expect": {
            "status": "editing",
            "valid": false,
            "dirty": false,
            "canSubmit": true,
            "fields": {
              "email": {
                "value": "",
                "touched": false,
                "errors": [
                  "required"
                ],
                "required": true
              },
              "company": {
                "visible": false,
                "required": false,
                "errors": []
              },
              "referral": {
                "value": "friend-7",
                "errors": []
              }
            }
          }
        },
        {
          "submit": {
            "submitter": "create"
          },
          "expect": {
            "status": "editing",
            "valid": false,
            "ignored": "invalid",
            "fields": {
              "email": {
                "touched": true
              },
              "password": {
                "touched": true
              },
              "plan": {
                "touched": true
              },
              "terms": {
                "touched": true,
                "errors": [
                  "required"
                ]
              },
              "company": {
                "touched": false
              },
              "legacyId": {
                "touched": false,
                "errors": []
              },
              "referral": {
                "touched": false
              }
            }
          }
        }
      ]
    },
