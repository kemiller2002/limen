                "touched": false,
                "errors": []
              },
              "legacyId": {
                "value": ""
              }
            },
            "emitted": [
              {
                "validate": {
                  "field": "email",
                  "value": "ada@example.com",
                  "token": "v1"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "submission lifecycle: success, server errors, failure and an unknown outcome",
      "schema": "signup",
      "steps": [
        {
          "load": {
            "values": {
              "referral": "friend-7",
              "legacyId": "L-1",
              "terms": "false",
              "topics": [
                "news"
              ]
            },
            "rows": {}
          },
          "expect": {
            "status": "editing"
          }
        },
        {
          "fill": {
            "values": {
              "password": "correct horse",
              "plan": "free",
              "terms": "true",
              "age": "36",
              "budget": "10.5"
            }
          },
          "expect": {
            "valid": false
          }
        },
        {
          "input": {
            "field": "email",
            "value": "ada@example.com"
          },
          "expect": {
            "emitted": [
              {
                "validate": {
                  "field": "email",
                  "value": "ada@example.com",
                  "token": "v1"
                }
              }
            ]
          }
        },
        {
          "submit": {
            "submitter": "create"
          },
          "expect": {
            "ignored": "validation-pending",
            "status": "editing",
            "valid": false,
            "fields": {
              "email": {
                "pending": true,
                "touched": true
              }
            }
          }
        },
        {
          "asyncResult": {
            "field": "email",
            "token": "v1",
            "error": null
          },
          "expect": {
            "valid": true
          }
        },
        {
          "submit": {
            "submitter": "create"
          },
          "expect": {
            "status": "submitting",
            "canSubmit": false,
            "emitted": [
              {
                "submit": {
                  "token": "s1",
                  "submitter": "create",
                  "values": {
                    "email": "ada@example.com",
                    "password": "correct horse",
                    "age": 36,
                    "plan": "free",
                    "topics": [
                      "news"
                    ],
                    "terms": true,
                    "budget": 10.5,
                    "referral": "friend-7"
                  }
                }
              }
            ]
          }
        },
        {
          "submit": {
            "submitter": "create"
          },
          "expect": {
            "ignored": "in-flight",
            "status": "submitting"
          }
        },
        {
          "submitResult": {
            "token": "s0",
            "outcome": {
              "kind": "success"
            }
          },
          "expect": {
            "ignored": "stale-submit",
            "status": "submitting"
          }
        },
        {
          "submitResult": {
            "token": "s1",
            "outcome": {
              "kind": "rejected",
              "fields": {
                "email": [
                  "already registered"
                ],
                "shoeSize": [
                  "unknown to this form"
                ]
              },
              "global": [
                "Try again later"
              ]
            }
          },
          "expect": {
            "status": "rejected",
            "canSubmit": true,
            "valid": false,
            "global": [
              "Try again later",
              "shoeSize: unknown to this form"
            ],
            "fields": {
              "email": {
                "errors": [
                  "already registered"
                ]
              }
            }
          }
        },
        {
          "input": {
            "field": "email",
            "value": "ada2@example.com"
          },
          "expect": {
            "status": "editing",
            "global": [
              "Try again later",
              "shoeSize: unknown to this form"
            ],
            "fields": {
              "email": {
                "errors": [],
                "pending": true
              }
            },
            "emitted": [
              {
                "validate": {
                  "field": "email",
                  "value": "ada2@example.com",
                  "token": "v2"
                }
              }
            ]
          }
        },
        {
          "asyncResult": {
            "field": "email",
            "token": "v2",
            "error": null
          },
          "expect": {
            "valid": true
          }
        },
        {
          "submit": {
            "submitter": "create"
          },
          "expect": {
            "status": "submitting",
            "global": [],
            "emitted": [
              {
                "submit": {
                  "token": "s2",
                  "submitter": "create",
                  "values": {
                    "email": "ada2@example.com",
                    "password": "correct horse",
                    "age": 36,
                    "plan": "free",
                    "topics": [
                      "news"
                    ],
                    "terms": true,
                    "budget": 10.5,
                    "referral": "friend-7"
                  }
                }
              }
            ]
          }
        },
        {
          "submitResult": {
            "token": "s2",
            "outcome": {
              "kind": "failed"
            }
          },
          "expect": {
            "status": "failed",
            "canSubmit": true,
            "dirty": true
          }
        },
        {
          "submit": {
            "submitter": "retry"
          },
          "expect": {
            "status": "submitting",
            "emitted": [
              {
                "submit": {
                  "token": "s3",
                  "submitter": "retry",
                  "values": {
                    "email": "ada2@example.com",
                    "password": "correct horse",
                    "age": 36,
                    "plan": "free",
                    "topics": [
                      "news"
                    ],
                    "terms": true,
                    "budget": 10.5,
                    "referral": "friend-7"
                  }
                }
              }
            ]
          }
        },
        {
          "submitResult": {
            "token": "s3",
            "outcome": {
              "kind": "unknown"
            }
          },
          "expect": {
            "status": "unknown",
            "canSubmit": false
          }
        },
        {
          "submit": {
            "submitter": "retry"
          },
          "expect": {
            "ignored": "outcome-unknown",
            "status": "unknown"
          }
        },
        {
          "reset": {},
          "expect": {
            "ignored": "outcome-unknown",
            "status": "unknown"
          }
        },
