    {
      "name": "async validation is correlated and stale-safe",
      "schema": "signup",
      "steps": [
        {
          "load": {
            "values": {},
            "rows": {}
          },
          "expect": {
            "status": "editing"
          }
        },
        {
          "input": {
            "field": "email",
            "value": "ada@example.com"
          },
          "expect": {
            "fields": {
              "email": {
                "pending": true,
                "errors": []
              }
            },
            "valid": false,
            "emitted": [
              {
                "validate": {
                  "field": "email",
                  "value": "ada@example.com",
                  "token": "v1"
                }
              }
            ]
          }
        },
        {
          "input": {
            "field": "email",
            "value": "grace@example.com"
          },
          "expect": {
            "fields": {
              "email": {
                "pending": true
              }
            },
            "emitted": [
              {
                "validate": {
                  "field": "email",
                  "value": "grace@example.com",
                  "token": "v2"
                }
              }
            ]
          }
        },
        {
          "asyncResult": {
            "field": "email",
            "token": "v1",
            "error": "taken"
          },
          "expect": {
            "ignored": "stale-async",
            "fields": {
              "email": {
                "value": "grace@example.com",
                "pending": true,
                "errors": []
              }
            }
          }
        },
        {
          "asyncResult": {
            "field": "email",
            "token": "v2",
            "error": "taken"
          },
          "expect": {
            "fields": {
              "email": {
                "pending": false,
                "errors": [
                  "taken"
                ]
              }
            }
          }
        },
        {
          "input": {
            "field": "email",
            "value": "not an email that is way too long for the forty limit"
          },
          "expect": {
            "fields": {
              "email": {
                "pending": false,
                "errors": [
                  "too-long"
                ]
              }
            }
          }
        },
        {
          "asyncResult": {
            "field": "email",
            "token": "v2",
            "error": null
          },
          "expect": {
            "ignored": "stale-async"
          }
        },
        {
          "input": {
            "field": "email",
            "value": "lin@example.com"
          },
          "expect": {
            "emitted": [
              {
                "validate": {
                  "field": "email",
                  "value": "lin@example.com",
                  "token": "v3"
                }
              }
            ]
          }
        },
        {
          "submit": {
            "submitter": "create"
          },
          "expect": {
            "ignored": "invalid",
            "status": "editing",
            "fields": {
              "email": {
                "touched": true
              }
            }
          }
        },
        {
          "asyncResult": {
            "field": "email",
            "token": "v3",
            "error": null
          },
          "expect": {
            "fields": {
              "email": {
                "pending": false,
                "errors": []
              }
            }
          }
        }
      ]
    },
