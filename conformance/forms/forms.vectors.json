                "dirty": false,
                "touched": false
              }
            }
          }
        },
        {
          "input": {
            "field": "age",
            "value": "37"
          },
          "expect": {
            "status": "editing",
            "dirty": true,
            "fields": {
              "age": {
                "dirty": true
              }
            }
          }
        }
      ]
    },
    {
      "name": "edits during submission stay dirty after success; a not-applied unknown returns to editing",
      "schema": "order",
      "steps": [
        {
          "load": {
            "values": {
              "customer": "ACME"
            },
            "rows": {
              "lines": [
                {
                  "key": "a",
                  "values": {
                    "item": "Pen",
                    "qty": "2"
                  }
                }
              ]
            }
          },
          "expect": {
            "status": "editing",
            "valid": true,
            "dirty": false
          }
        },
        {
          "input": {
            "field": "customer",
            "value": "ACME Corp"
          },
          "expect": {
            "dirty": true
          }
        },
        {
          "submit": {
            "submitter": "save"
          },
          "expect": {
            "status": "submitting",
            "emitted": [
              {
                "submit": {
                  "token": "s1",
                  "submitter": "save",
                  "values": {
                    "customer": "ACME Corp",
                    "lines": [
                      {
                        "key": "a",
                        "values": {
                          "item": "Pen",
                          "qty": 2
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "input": {
            "field": "customer",
            "value": "ACME Corporation"
          },
          "expect": {
            "status": "submitting"
          }
        },
        {
          "submitResult": {
            "token": "s1",
            "outcome": {
              "kind": "success"
            }
          },
          "expect": {
            "status": "submitted",
            "dirty": true,
            "fields": {
              "customer": {
                "value": "ACME Corporation",
                "dirty": true
              }
            }
          }
        },
        {
          "submit": {
            "submitter": "save"
          },
          "expect": {
            "status": "submitting",
            "emitted": [
              {
                "submit": {
                  "token": "s2",
