<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The CLI project publishes as a trimmed single file; referencing it from
         a test project must not inherit that. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BoundaryTests.fs" />
    <Compile Include="ManifestTests.fs" />
    <Compile Include="PlanningTests.fs" />
    <Compile Include="LifecycleTests.fs" />
    <Compile Include="CliTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Limen.Core/Limen.Core.fsproj" />
    <ProjectReference Include="../../Limen.Cli/Limen.Cli.fsproj" />
  </ItemGroup>

</Project>
