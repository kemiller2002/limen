// Generates Examples.fs: the controlled examples for `limen wasm-check`.
//
//   dotnet fsi cli/tests/InterpreterFrame.Examples/generate.fsx
//
// The InterpreterFrame.Examples project runs this before its first build;
// Examples.fs is not committed. Each size below places its example on a known
// side of a threshold when compiled by .NET SDK 10 (F# 10); see
// docs/57-wasm-interpreter-frame-check.md for the measured table.
open System.IO
open System.Text

let largeOver = 34 // keys in Large.project: over the 65,535-byte limit
let largeNear = 26 // keys in LargeNear.project: just under the limit
let largeEdge = 27 // keys in LargeEdge.project: just over the limit
let nestedOver = 34 // keys in Nested.project
let closureOver = 160 // captured values in Closures.project
let matchOver = 160 // cases in GeneratedMatch.project
let matchNear = 100 // cases in GeneratedMatchNear.project
let matchEdge = 132 // cases in GeneratedMatchEdge.project: just over the limit
let structOver = 28 // struct values in StructLocals.project: over the limit only when value types are sized
let structNear = 26 // struct values in StructLocalsNear.project: just under the limit
let areaKeys = 6 // keys per area function in Split

let out = StringBuilder()
let line (text: string) = out.AppendLine text |> ignore

/// Six conditional values in a list literal. This is the shape the F#
/// compiler produces when it inlines a small helper into a projection: each
/// branch result is spilled to its own IL local, and none is reused.
let row (i: int) =
    [ for j in 0..5 -> sprintf "(if m.Count > %d then m.Name else \"none\")" ((i * 6 + j) % 7) ]
    |> String.concat "; "
    |> sprintf "String.concat \",\" [ %s ]"

let key (prefix: string) (i: int) = sprintf "\"%s%04d\", text (%s)" prefix i (row i)

line "// <auto-generated> by generate.fsx in this directory. Do not edit by hand. </auto-generated>"
line "/// Controlled examples for `limen wasm-check`: F# shapes measured against the"
line "/// real .NET WebAssembly interpreter (docs/57-wasm-interpreter-frame-check.md)."
line "/// Each `project` is called once by the interpreter probe; the static check"
line "/// must classify each exactly as the interpreter did."
line "module Limen.InterpreterFrame.Examples"
line ""
line "open System.Runtime.CompilerServices"
line ""
line "type ViewValue ="
line "    | Text of string"
line "    | Flag of bool"
line "    | Group of (string * ViewValue) list"
line ""
line "type Model = { Name: string; Count: int; Selected: string option }"
line ""
line "let initial = { Name = \"probe\"; Count = 3; Selected = Some \"s\" }"
line ""
line "let private text (s: string) = Text s"
line "let private group (fields: (string * ViewValue) list) = Group fields"
line ""
line "/// (1) A small projection: a handful of keys."
line "module Small ="
line "    let project (m: Model) : Map<string, ViewValue> ="
line "        Map.ofList ["
for i in 0..2 do line ("            " + key "s" i)
line "        ]"
line ""
let flat (name: string) (doc: string) (prefix: string) (count: int) =
    line (sprintf "/// %s" doc)
    line (sprintf "module %s =" name)
    line "    let project (m: Model) : Map<string, ViewValue> ="
    line "        Map.ofList ["
    for i in 0..count - 1 do line ("            " + key prefix i)
    line "        ]"
    line ""
flat "Large" "(2) A large projection: one method, every key inline. Over the limit." "k" largeOver
flat "LargeNear" "(2b) The same shape with fewer keys: just under the limit." "k" largeNear
flat "LargeEdge" "(2c) The same shape just over the limit: where the interpreter's optimized retry could rescue it." "k" largeEdge
line "/// (3) The keys of Large, split per area into top-level functions, with the"
line "/// helper marked NoInlining: the remedy wasm-check recommends."
line "module Split ="
line "    [<MethodImpl(MethodImplOptions.NoInlining)>]"
line "    let private pickOnce (m: Model) (i: int) = if m.Count > i % 7 then m.Name else \"none\""
line ""
let areas = (largeOver + areaKeys - 1) / areaKeys
for a in 0..areas - 1 do
    line (sprintf "    let area%02d (m: Model) : (string * ViewValue) list =" a)
    line "        ["
    for i in a * areaKeys .. min largeOver ((a + 1) * areaKeys) - 1 do
        line (sprintf "            \"k%04d\", text (String.concat \",\" [ %s ])" i ([ for j in 0..5 -> sprintf "pickOnce m %d" (i * 6 + j) ] |> String.concat "; "))
    line "        ]"
    line ""
line "    let project (m: Model) : Map<string, ViewValue> ="
line (sprintf "        Map.ofList (List.concat [ %s ])" ([ for a in 0..areas - 1 -> sprintf "area%02d m" a ] |> String.concat "; "))
line ""
line "/// (4) A deeply nested projection: each key is a group four levels deep."
line "module Nested ="
line "    let project (m: Model) : Map<string, ViewValue> ="
line "        Map.ofList ["
for i in 0..nestedOver - 1 do
    line (sprintf "            \"n%04d\", group [ \"a\", group [ \"b\", group [ \"c\", group [ \"d\", text (%s) ] ] ] ]" i (row i))
line "        ]"
line ""
line "/// (5) Many captured values: every value is computed in project and captured"
line "/// by one closure that builds the view. The values are locals of project; the"
line "/// closure holds them as fields."
line "module Closures ="
line "    let project (m: Model) : Map<string, ViewValue> ="
for i in 0..closureOver - 1 do
    line (sprintf "        let v%04d = %s" i (row i))
line "        let render (suffix: string) ="
line "            Map.ofList ["
for i in 0..closureOver - 1 do
    line (sprintf "                \"c%04d\", text (v%04d + suffix)" i i)
line "            ]"
line "        let view = render"
line "        view \"\""
line ""
let matcher (name: string) (doc: string) (count: int) =
    line (sprintf "/// %s" doc)
    line (sprintf "module %s =" name)
    line "    let project (m: Model) (key: string) : ViewValue ="
    line "        match key with"
    for i in 0..count - 1 do
        line (sprintf "        | \"m%04d\" -> text (%s)" i (row i))
    line "        | _ -> Flag false"
    line ""
matcher "GeneratedMatch" "(6) A large generated match expression: one case per key. Over the limit." matchOver
matcher "GeneratedMatchNear" "(6b) The same shape with fewer cases: past the warning, under the limit." matchNear
matcher "GeneratedMatchEdge" "(6c) The same shape just over the limit: where the interpreter's optimized retry could rescue it." matchEdge

let structs (name: string) (doc: string) (count: int) =
    line (sprintf "/// %s" doc)
    line (sprintf "module %s =" name)
    line "    let project (m: Model) : decimal ="
    line "        ["
    for i in 0..count - 1 do
        line (sprintf "            (if m.Count > %d then struct (%dm, 1m, 2m, 3m) else struct (0m, 0m, 0m, 0m))" (i % 7) i)
    line "        ]"
    line "        |> List.sumBy (fun struct (a, b, c, d) -> a + b + c + d)"
    line ""
structs "StructLocals" "(7) Value-type locals: each spilled value is a struct of four decimals (64 bytes on wasm32). Counted at 8 bytes each it would pass; sized from its fields it is over the limit." structOver
structs "StructLocalsNear" "(7b) The same shape with fewer values: just under the limit when sized from fields." structNear

File.WriteAllText(Path.Combine(__SOURCE_DIRECTORY__, "Examples.fs"), out.ToString())
printfn "wrote Examples.fs (%d bytes)" out.Length
