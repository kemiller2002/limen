<Project Sdk="Microsoft.NET.Sdk">

  <!-- Controlled examples for `limen wasm-check` (docs/57-wasm-interpreter-frame-check.md).

       Not part of `npm run test:cli`: the shapes depend on the F# compiler.
       Built with .NET SDK 10 (F# 10) they produce the frames measured against
       the WebAssembly interpreter; built with SDK 8 (F# 8) the same source
       spills almost nothing. The measured facts are recorded in
       cli/tests/Limen.Core.Tests/InterpreterFrameTests.fs.

       Examples.fs is generated by generate.fsx before the first build and is
       not committed. Optimize is forced on so the IL has the Release shape
       whichever configuration builds it. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Optimize>true</Optimize>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Examples.fs" />
  </ItemGroup>

  <Target Name="GenerateExamples" BeforeTargets="CoreCompile" Condition="!Exists('$(MSBuildProjectDirectory)/Examples.fs')">
    <Exec Command="dotnet fsi &quot;$(MSBuildProjectDirectory)/generate.fsx&quot;" />
  </Target>

</Project>
