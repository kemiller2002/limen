<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The published executable is named `limen`; the npm launcher looks for
         exactly this name under runtimes/<rid>/. -->
    <AssemblyName>limen</AssemblyName>
    <RootNamespace>Limen.Cli</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Distribution: one self-contained, trimmed, single-file executable per
         platform. Self-contained because `npx` users cannot be assumed to have
         a .NET runtime; trimmed because 13 MB per platform is the difference
         between a practical npm package and an impractical one. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebugType>none</DebugType>
    <!-- Version is supplied by the build from package.json. The default here
         exists only so a plain `dotnet build` works during development. -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Args.fs" />
    <Compile Include="Help.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Limen.Core/Limen.Core.fsproj" />
  </ItemGroup>

</Project>
