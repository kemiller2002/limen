<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <!-- No browser, no JS interop, no I/O. If this project ever needs a
         package reference to reach the host, the boundary has broken. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Projection.fs" />
    <Compile Include="Engine.fs" />
  </ItemGroup>

</Project>
