{
  "name": "limen",
  "project": "Limen",
  "rosVersion": "1.2.1",
  "repSpecificationVersion": "2.0",
  "profile": "greenfield",
  "bootstrap": "BOOTSTRAP.md",
  "canonicalRoots": {
    "journals": "research/journals",
    "packages": "research/packages",
    "theories": "research/theories",
    "evidence": "research/evidence"
  },
  "registries": "registries",
  "templates": "templates",
  "generated": "generated",
  "repository": {
    "id": "limen",
    "type": "application"
  },
  "workProtocol": {
    "version": "1.0.0",
    "enforceAttribution": true,
    "semanticMapping": {
      "ready": "ready",
      "active": "active",
      "blocked": "blocked",
      "complete": "complete"
    },
    "completionEvidence": {
      "default": [
        "implementation",
        "tests"
      ],
      "research": [
        "research-record"
      ],
      "mechanical": []
    },
    "meaningfulPaths": [
      "**"
    ],
    "ignoredPaths": [
      ".git/**",
      ".ros/context/**",
      ".ros/events/**",
      ".ros/work/**",
      "registries/**"
    ]
  }
}
