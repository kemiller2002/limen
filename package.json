    },
    "./testing/views": {
      "types": "./dist/tooling/view-contract.d.ts",
      "import": "./dist/tooling/view-contract.js"
    },
    "./trace": {
      "types": "./dist/tooling/trace.d.ts",
      "import": "./dist/tooling/trace.js"
    },
    "./kernel": {
      "types": "./dist/kernel/browser-kernel.d.ts",
      "import": "./dist/kernel/browser-kernel.js"
    },
    "./reference-engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./federation": {
      "types": "./dist/federation.d.ts",
      "import": "./dist/federation.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    }
  },
  "bin": {
    "limen": "./bin/limen.js",
    "typescript-wasm-kernel": "./bin/limen.js"
  },
  "files": [
    "dist",
    "!dist/main.*",
    "bin",
    "runtimes",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "architecture.yaml",
    "docs/core-mental-model.md",
    "docs/quick-start.md",
    "docs/mental-model.md",
    "docs/where-code-goes.md",
    "docs/11-api-reference.md",
    "docs/16-troubleshooting.md",
    "docs/glossary.md",
    "examples/minimal",
    "docs/23-wasm-federation.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiller2002/limen.git"
  },
  "bugs": {
    "url": "https://github.com/kemiller2002/limen/issues"
  },
  "homepage": "https://github.com/kemiller2002/limen#readme",
  "keywords": [
    "limen",
    "browser-kernel",
    "typescript",
    "architecture",
    "state-management",
    "functional-core",
    "boundary",
    "interop",
    "effects",
    "webassembly",
    "wasm",
    "echelon-foundry",
    "cli",
    "repository-tooling",
    "verification"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "build:examples": "tsc -p tsconfig.examples.json",
    "build:site": "npm run build:site:wasm && npm run test:site:fsharp && tsc -p tsconfig.site.json && node --experimental-strip-types scripts/build-site.ts",
    "dev": "node --experimental-strip-types scripts/dev-server.ts",
    "serve:site": "npm run build:site && python3 -m http.server 4174 -d dist-site",
    "check:architecture": "node --experimental-strip-types scripts/check-architecture.ts",
    "check:docs": "node --experimental-strip-types scripts/check-docs.ts",
    "build:cli": "node --experimental-strip-types scripts/build-cli.ts --current",
    "build:cli:all": "node --experimental-strip-types scripts/build-cli.ts",
    "test:cli": "dotnet test cli/tests/Limen.Core.Tests/Limen.Core.Tests.fsproj --nologo -v q",
    "pretest": "npm run build && npm run build:examples && npm run build:site && npm run build:bench",
    "test": "npm run contract:check && npm run check:architecture && npm run check:core-budget && npm run check:layers && npm run check:typescript && npm run check:docs && npm run check:views && npm run check:site && npm run check:package && node --experimental-strip-types --test test/*.test.ts",
    "check": "npm test",
    "check:core-budget": "node --experimental-strip-types scripts/check-core-budget.ts",
    "prepack": "npm run clean && npm run check && npm run build:cli:all",
    "check:site": "node --experimental-strip-types scripts/check-site.ts",
    "check:package": "node --experimental-strip-types scripts/check-package.ts",
    "check:clean-room": "node --experimental-strip-types scripts/clean-room.ts",
    "smoke:browser": "node --experimental-strip-types scripts/browser-smoke.ts",
    "build:site:wasm": "dotnet workload restore site/fsharp/Limen.Site.Wasm/Limen.Site.Wasm.csproj && dotnet publish site/fsharp/Limen.Site.Wasm/Limen.Site.Wasm.csproj -c Release -o site/fsharp/publish && dotnet publish site/fsharp/federation/Limen.Federation.Source.Wasm/Limen.Federation.Source.Wasm.csproj -c Release -o site/fsharp/federation/Limen.Federation.Source.Wasm/publish && dotnet publish site/fsharp/federation/Limen.Federation.Target.Wasm/Limen.Federation.Target.Wasm.csproj -c Release -o site/fsharp/federation/Limen.Federation.Target.Wasm/publish",
    "test:site:fsharp": "dotnet run --project site/fsharp/tests/Limen.Site.Engine.Tests/Limen.Site.Engine.Tests.fsproj -c Release && dotnet run --project site/fsharp/federation/tests/Limen.Federation.Proof.Tests/Limen.Federation.Proof.Tests.fsproj -c Release",
    "smoke:site:wasm": "bash scripts/smoke-site-wasm.sh",
    "contract:generate": "node --experimental-strip-types tools/contract-gen/main.ts generate",
    "contract:check": "node --experimental-strip-types tools/contract-gen/main.ts check",
    "test:guests": "npm run test:guests:fsharp && npm run test:guests:csharp && npm run test:guests:rust && npm run test:guests:sessions && npm run test:libraries && npm run test:guests:pressure",
    "test:libraries": "dotnet run --project conformance/routing/fsharp/Limen.Routing.Conformance/Limen.Routing.Conformance.fsproj -c Release --nologo && dotnet run --project conformance/forms/fsharp/Limen.Forms.Conformance/Limen.Forms.Conformance.fsproj -c Release --nologo && dotnet run --project conformance/resources/fsharp/Limen.Resources.Conformance/Limen.Resources.Conformance.fsproj -c Release --nologo && dotnet run --project conformance/http/fsharp/Limen.Http.Conformance/Limen.Http.Conformance.fsproj -c Release --nologo && dotnet run --project conformance/localization/fsharp/Limen.Localization.Conformance/Limen.Localization.Conformance.fsproj -c Release --nologo && dotnet run --project conformance/outbox/fsharp/Limen.Outbox.Conformance/Limen.Outbox.Conformance.fsproj -c Release --nologo",
    "test:guests:fsharp": "dotnet run --project guests/fsharp/Limen.Contract.Conformance/Limen.Contract.Conformance.fsproj -c Release --nologo",
    "test:guests:csharp": "dotnet run --project guests/csharp/Limen.Contract.Conformance/Limen.Contract.Conformance.csproj -c Release --nologo",
    "test:guests:rust": "cargo test --manifest-path guests/rust/limen-contract/Cargo.toml --locked",
    "check:layers": "node --experimental-strip-types scripts/check-layers.ts",
    "check:scope": "node --experimental-strip-types scripts/check-scope.ts",
    "check:typescript": "node --experimental-strip-types scripts/check-typescript.ts",
    "test:guests:pressure": "node --experimental-strip-types scripts/guest-pressure.ts",
    "build:guests": "node --experimental-strip-types scripts/build-guests-site.ts",
    "smoke:guests": "node --experimental-strip-types scripts/smoke-guests.ts",
    "smoke:packs": "npm run build && npm run build:examples && node --experimental-strip-types scripts/smoke-packs.ts",
    "smoke:security": "npm run build && node --experimental-strip-types scripts/smoke-security.ts",
    "check:views": "node --experimental-strip-types scripts/check-views.ts",
    "build:bench": "tsc -p tsconfig.bench.json",
    "bench": "npm run build && npm run build:bench && node --experimental-strip-types scripts/bench.ts",
    "bench:worker": "npm run build && node --experimental-strip-types scripts/bench-worker.ts",
    "test:guests:sessions": "dotnet run --project guests/minimal/fsharp/Limen.Minimal.Sessions/Limen.Minimal.Sessions.fsproj -c Release --nologo && dotnet run --project guests/minimal/csharp/Limen.Minimal.Sessions/Limen.Minimal.Sessions.csproj -c Release --nologo && cargo test --quiet --manifest-path guests/minimal/rust/limen-minimal/Cargo.toml"
  },
  "devDependencies": {
    "@echelon-foundry/repository-operating-system": "^1.2.1",
    "@types/jsdom": "^30.0.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2"
  }
}
