    },
    "./capabilities/files": {
      "types": "./dist/capabilities/files/index.d.ts",
      "import": "./dist/capabilities/files/index.js"
    },
    "./capabilities/store": {
      "types": "./dist/capabilities/store/index.d.ts",
      "import": "./dist/capabilities/store/index.js"
    },
    "./capabilities/adapters": {
      "types": "./dist/capabilities/adapters/index.d.ts",
      "import": "./dist/capabilities/adapters/index.js"
    },
    "./capabilities/adapters/web-component": {
      "types": "./dist/capabilities/adapters/web-component.d.ts",
      "import": "./dist/capabilities/adapters/web-component.js"
    },
    "./capabilities/transfer": {
      "types": "./dist/capabilities/transfer/index.d.ts",
      "import": "./dist/capabilities/transfer/index.js"
    },
    "./capabilities/presentation": {
      "types": "./dist/capabilities/presentation/index.d.ts",
