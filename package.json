    },
    "./capabilities/lifecycle": {
      "types": "./dist/capabilities/lifecycle/index.d.ts",
      "import": "./dist/capabilities/lifecycle/index.js"
    },
    "./capabilities/offline": {
      "types": "./dist/capabilities/offline/index.d.ts",
      "import": "./dist/capabilities/offline/index.js"
    },
    "./capabilities/offline/worker": {
      "types": "./dist/capabilities/offline/worker.d.ts",
      "import": "./dist/capabilities/offline/worker.js"
    },
    "./capabilities/media": {
      "types": "./dist/capabilities/media/index.d.ts",
      "import": "./dist/capabilities/media/index.js"
    },
    "./capabilities/peer": {
      "types": "./dist/capabilities/peer/index.d.ts",
