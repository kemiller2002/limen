{
  "name": "@echelon-foundry/typescript-wasm-kernel",
  "version": "0.4.1",
  "description": "Limen: an explicit boundary that keeps browser capabilities separate from application authority — a dependency-free browser kernel library, plus a repository lifecycle CLI that initializes, verifies, diagnoses and upgrades that boundary.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./kernel": {
      "types": "./dist/kernel/browser-kernel.d.ts",
      "import": "./dist/kernel/browser-kernel.js"
    },
    "./reference-engine": {
      "types": "./dist/engine/transport.d.ts",
      "import": "./dist/engine/transport.js"
    }
  },
  "bin": {
    "limen": "./bin/limen.js",
    "typescript-wasm-kernel": "./bin/limen.js"
  },
  "files": [
    "dist",
    "!dist/main.*",
    "bin",
    "runtimes",
    "README.md",
    "LICENSE",
    "architecture.yaml"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiller2002/typescript-wasm-kernel.git"
  },
  "bugs": {
    "url": "https://github.com/kemiller2002/typescript-wasm-kernel/issues"
  },
  "homepage": "https://github.com/kemiller2002/typescript-wasm-kernel#readme",
  "keywords": [
    "browser-kernel",
    "typescript",
    "webassembly",
    "wasm",
    "functional-core",
    "limen",
    "echelon-foundry",
    "cli",
    "repository-tooling",
    "verification"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "build:examples": "tsc -p tsconfig.examples.json",
    "build:site": "tsc -p tsconfig.site.json && node --experimental-strip-types scripts/build-site.ts",
    "serve:site": "npm run build:site && python3 -m http.server 4174 -d dist-site",
    "check:architecture": "node --experimental-strip-types scripts/check-architecture.ts",
    "check:docs": "node --experimental-strip-types scripts/check-docs.ts",
    "build:cli": "node --experimental-strip-types scripts/build-cli.ts --current",
    "build:cli:all": "node --experimental-strip-types scripts/build-cli.ts",
    "test:cli": "dotnet test cli/tests/Limen.Core.Tests/Limen.Core.Tests.fsproj --nologo -v q",
    "pretest": "npm run build && npm run build:examples && npm run build:site",
    "test": "npm run check:architecture && npm run check:docs && npm run check:site && node --experimental-strip-types --test test/*.test.ts",
    "check": "npm test",
    "prepack": "npm run clean && npm run check && npm run build:cli:all",
    "check:site": "node --experimental-strip-types scripts/check-site.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@echelon-foundry/repository-operating-system": "^1.2.1"
  }
}
