    },
    "./capabilities/coordination": {
      "types": "./dist/capabilities/coordination/index.d.ts",
      "import": "./dist/capabilities/coordination/index.js"
    },
    "./capabilities/coordination/hub": {
      "types": "./dist/capabilities/coordination/hub.d.ts",
      "import": "./dist/capabilities/coordination/hub.js"
    },
    "./hosts/fallback": {
      "types": "./dist/hosts/fallback.d.ts",
      "import": "./dist/hosts/fallback.js"
    },
    "./capability-support/handles": {
      "types": "./dist/capability-support/handles.d.ts",
      "import": "./dist/capability-support/handles.js"
    },
    "./hosts/dotnet-wasm": {
      "types": "./dist/hosts/dotnet-wasm-transport.d.ts",
