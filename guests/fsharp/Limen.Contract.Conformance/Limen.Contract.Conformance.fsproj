<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs conformance/vectors/*.vectors.json through the generated F#
       binding. Generated/FixtureEcho.fs is a test-only capability unit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Generated/FixtureEcho.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Contract/Limen.Contract.fsproj" />
  </ItemGroup>
</Project>
