<Project Sdk="Microsoft.NET.Sdk">
  <!-- A reference consumer: handles contract unions exhaustively, with no
       wildcard. scripts/guest-pressure.ts recompiles it against a contract
       with an added variant and requires the build to fail. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Consumer.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Contract/Limen.Contract.fsproj" />
  </ItemGroup>
</Project>
