<Project Sdk="Microsoft.NET.Sdk">
  <!-- Handwritten guest-side protocol support for F# engines: the engine's
       half of the handshake. Pure; no browser, interop or I/O. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <!-- The reflectionfree flag: no %A formatting and no reflection-generated ToString,
         so a trimmed WebAssembly host keeps no F# printf (WI-0143). -->
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25 --reflectionfree</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Handshake.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Contract/Limen.Contract.fsproj" />
  </ItemGroup>
</Project>
