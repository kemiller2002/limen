<Project Sdk="Microsoft.NET.Sdk">
  <!-- Handwritten guest-side protocol support for F# engines: the engine's
       half of the handshake. Pure; no browser, interop or I/O. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <!-- The reflectionfree flag: no %A formatting and no reflection-generated ToString,
         so a trimmed WebAssembly host keeps no F# printf (WI-0143). -->
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25 --reflectionfree</OtherFlags>
    <!-- NuGet package (LCP-044, LCP-079). The version is package.json's,
         passed at pack time by scripts/nuget-packages.ts (lockstep,
         OQ-LIMEN-IDB-005); 0.0.0 means "not packed from a release". -->
    <PackageId>EchelonFoundry.Limen.Guest</PackageId>
    <Version>0.0.0</Version>
    <Authors>Echelon Foundry</Authors>
    <Description>The engine's half of the Limen handshake for F# engines: answer the host's offer, selecting the capabilities the engine requires (for example limen.store with its fingerprint). Pure.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kemiller2002/limen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kemiller2002/limen</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>limen;webassembly;wasm;fsharp;indexeddb</PackageTags>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Handshake.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Contract/Limen.Contract.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
