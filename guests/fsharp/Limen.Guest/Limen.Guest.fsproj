<Project Sdk="Microsoft.NET.Sdk">
  <!-- Handwritten guest-side protocol support for F# engines: the engine's
       half of the handshake. Pure; no browser, interop or I/O. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Handshake.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Contract/Limen.Contract.fsproj" />
  </ItemGroup>
</Project>
