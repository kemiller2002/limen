<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated F# bindings for the Limen contract. Files under Generated/
       come from tools/contract-gen; never edit them. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <!-- 25: incomplete matches, 1182: unused variables, 3370: deprecated
         syntax. Incomplete pattern handling at a Limen boundary is an error. -->
    <!-- The reflectionfree flag: no %A formatting and no reflection-generated ToString,
         so a trimmed WebAssembly host keeps no F# printf (WI-0143). -->
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25 --reflectionfree</OtherFlags>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Generated/Runtime.fs" />
    <Compile Include="Generated/Core.fs" />
    <Compile Include="Generated/Focus.fs" />
    <Compile Include="Generated/Schedule.fs" />
    <Compile Include="Generated/Measure.fs" />
    <Compile Include="Generated/Events.fs" />
    <Compile Include="Generated/Overlay.fs" />
    <Compile Include="Generated/Realtime.fs" />
    <Compile Include="Generated/Files.fs" />
    <Compile Include="Generated/Store.fs" />
    <Compile Include="Generated/Adapters.fs" />
    <Compile Include="Generated/Transfer.fs" />
    <Compile Include="Generated/Presentation.fs" />
    <Compile Include="Generated/Environment.fs" />
    <Compile Include="Generated/Lifecycle.fs" />
    <Compile Include="Generated/Offline.fs" />
    <Compile Include="Generated/Geolocation.fs" />
    <Compile Include="Generated/Credentials.fs" />
    <Compile Include="Generated/Coordination.fs" />
    <Compile Include="Generated/Media.fs" />
    <Compile Include="Generated/Peer.fs" />
    <Compile Include="Generated/Federation.fs" />
  </ItemGroup>
</Project>
