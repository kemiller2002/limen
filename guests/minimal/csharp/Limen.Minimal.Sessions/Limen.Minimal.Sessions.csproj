<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs conformance/sessions/minimal.session.json through the C# minimal
       engine's real JSON boundary (Dispatch.Handle). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Minimal.Engine/Limen.Minimal.Engine.csproj" />
  </ItemGroup>
</Project>
