<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs conformance/sessions/minimal.session.json through the F# minimal
       engine's real JSON boundary (Dispatch.handle). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Minimal.Engine/Limen.Minimal.Engine.fsproj" />
  </ItemGroup>
</Project>
