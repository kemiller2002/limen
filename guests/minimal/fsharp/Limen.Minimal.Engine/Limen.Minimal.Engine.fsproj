<Project Sdk="Microsoft.NET.Sdk">
  <!-- The minimal engine (conformance/sessions/minimal-engine.md) in F#.
       Application meaning only: no browser, interop or I/O. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <!-- The reflectionfree flag: no %A formatting and no reflection-generated ToString,
         so a trimmed WebAssembly host keeps no F# printf (WI-0143). -->
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25 --reflectionfree</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Engine.fs" />
    <Compile Include="Dispatch.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../fsharp/Limen.Contract/Limen.Contract.fsproj" />
    <ProjectReference Include="../../../fsharp/Limen.Guest/Limen.Guest.fsproj" />
  </ItemGroup>
</Project>
