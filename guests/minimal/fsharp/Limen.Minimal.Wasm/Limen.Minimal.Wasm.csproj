<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- .NET WebAssembly host for the F# engine. One [JSExport] method that
       forwards one serialized Limen message; no decision is made here.
       AllowUnsafeBlocks is required by the JSExport source generator's
       emitted marshalling code, not by anything written here. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Limen.Minimal.Wasm</RootNamespace>
    <!-- FSharp.Core 8.0.102's own ILLink descriptors raise IL2104/IL2008/IL2040
         under trimming; our generated code is trim-clean. Guest projects may
         not suppress warnings (test/guardrails.test.ts), so this host
         publishes untrimmed and the size cost is recorded, not hidden. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Minimal.Engine/Limen.Minimal.Engine.fsproj" />
    <SupportedPlatform Include="browser" />
  </ItemGroup>
</Project>
