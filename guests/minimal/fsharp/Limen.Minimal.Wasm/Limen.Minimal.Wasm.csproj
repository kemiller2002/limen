<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- .NET WebAssembly host for the F# engine. One [JSExport] method that
       forwards one serialized Limen message; no decision is made here.
       AllowUnsafeBlocks is required by the JSExport source generator's
       emitted marshalling code, not by anything written here. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Limen.Minimal.Wasm</RootNamespace>
    <!-- Trimmed in full mode (WI-0143): only reachable code is kept and
         analyzed. The F# projects compile with no printf and with
         reflection-free formatting, so every trim-analysis warning stays an
         error and none is raised.
         IL2040 alone is not an error. It is FSharp.Core's own trimming file
         naming resources the assembly does not contain, in every version from
         8.0.102 to 10.0.112 (docs/27). The owner approved this one exception
         (kemiller2002/limen#19), and architecture/guardrails.json declares
         it, so test/guardrails.test.ts refuses any other. It still prints.
         FSharp.Core is the SDK's own: pinning one would be a downgrade
         (NU1605) whenever the SDK ships a newer one. FSharp.Core 8.0.x also
         raises IL2008 here, so a trimmed publish needs an SDK whose
         FSharp.Core is 9.0 or later, as CI's is. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <WarningsNotAsErrors>IL2040</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Limen.Minimal.Engine/Limen.Minimal.Engine.fsproj" />
    <SupportedPlatform Include="browser" />
  </ItemGroup>
</Project>
